{
  "expo": {
    "name": "Speso",
    "slug": "expense-tracker",
    "version": "2.10.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expensetracker",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.shreyanshshah.expensetracker",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {},
      "buildNumber": "18"
    },
    "android": {
      "package": "com.shreyanshshah.expensetracker",
      "adaptiveIcon": {
        "backgroundColor": "#111518",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 18
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1A20",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 190
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-sharing",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your ledger."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#14C4A2"
        }
      ],
      "./plugins/with-android-backup.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6651582e-1467-4bd3-a7aa-51cb2c54589a"
      }
    },
    "owner": "shreyanshshah98",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6651582e-1467-4bd3-a7aa-51cb2c54589a"
    },
    "backgroundColor": "#111518"
  }
}
